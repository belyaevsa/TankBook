<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="JsonSchema.Net" Version="4.1.8" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The remote config JSON Schema (docs/CONFIG.md). Embedded at build time
         and used to validate every document at publish time - a malformed
         document must never reach a device. -->
    <EmbeddedResource Include="Config\config.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
    <!-- The canonical payload schemas (docs/schemas/v<N>/...). Embedded at build
         time and inserted into payload_schemas by migration 002, so adding or
         evolving an entity is a DATA change (a new file + a migration), never a
         per-entity code change (docs/SYNC.md "The schema registry lives in the
         database, not in code"). -->
    <EmbeddedResource Include="..\..\..\docs\schemas\v1\*.schema.json" Link="PayloadSchemas\v1\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
