+    // MARK: - The ink-band trim
+
+    /// The plain band with a full-width bezel band cut from its edges.
+    ///
+    /// A bezel row is solid: its ink runs across the strip, through the gaps
+    /// between glyphs. A glyph row is not - its strokes leave the inter-cell
+    /// gaps at the panel's level. So the band is walked inward from each edge
+    /// past the solid rows, then widened by `bandTrimMarginFraction` of the
+    /// plain band, but never back over a solid row. A strip whose band is all
+    /// glyph has no solid edge row and comes out unchanged; a strip with no
+    /// ink at all has no band and is returned as is.
+    ///
+    /// This is what keeps the pitch and the run threshold off the bezel a
+    /// loose detector box brings in: pump-092's litres box band ran 6..95 of
+    /// 96 with the bezel at 86..95, and the pitch and threshold were taken
+    /// over it.
+    ///
+    /// Returns the plain band when the cut core is shorter than
+    /// `bandTrimMinimumHeight` - a strip with no real glyph band has none to
+    /// trim to.
+    static func trimmedToInkBand(
+        ink: [Float], width: Int, plainTop: Int, plainBottom: Int, options: Options
+    ) -> (top: Int, bottom: Int) {
+        guard options.bandTrim, width > 0, ink.count >= width else { return (plainTop, plainBottom) }
+        let height = ink.count / width
+        guard plainTop >= 0, plainBottom < height, plainBottom > plainTop else {
+            return (plainTop, plainBottom)
+        }
+        let minimumSolid = options.bandTrimSolidFraction * Float(width)
+        func solid(_ y: Int) -> Bool {
+            var count = 0
+            for x in 0..<width where ink[y * width + x] > options.pixelInkThreshold {
+                count += 1
+                if Float(count) >= minimumSolid { return true }
+            }
+            return false
+        }
+        var top = plainTop
+        var bottom = plainBottom
+        while top < bottom, solid(top) { top += 1 }
+        while bottom > top, solid(bottom) { bottom -= 1 }
+        guard top != plainTop || bottom != plainBottom else { return (plainTop, plainBottom) }
+        let margin = Int(options.bandTrimMarginFraction * Float(plainBottom - plainTop + 1))
+        var wideTop = max(0, top - margin)
+        var wideBottom = min(height - 1, bottom + margin)
+        while wideTop < top, solid(wideTop) { wideTop += 1 }
+        while wideBottom > bottom, solid(wideBottom) { wideBottom -= 1 }
+        guard wideBottom > wideTop, wideBottom - wideTop + 1 >= options.bandTrimMinimumHeight else {
+            return (plainTop, plainBottom)
+        }
+        return (wideTop, wideBottom)
+    }
+
     static func percentile(_ values: [Float], _ p: Float) -> Float {
         guard !values.isEmpty else { return 0 }
         let sorted = values.sorted()
